# Frontend build variables. Copy to .env.local for dev, or set on your static host.
# Where the Express API is running (Render URL in production)
VITE_API_URL=http://localhost:3002

# Firebase web app config (Project settings > General > Your apps). Public values, not secrets.
# Alternative: put the same object in firebase-applet-config.json in the project root.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
