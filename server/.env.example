# Server secrets. The server reads server/.env and the root .env (root holds most keys today).
# On Render, set these as environment variables instead. Never commit the real files.
PORT=3002

# Cleanvoice AI: https://app.cleanvoice.ai/settings/api
CLEANVOICE_API_KEY=

# Cloudinary: Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin: Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Paystack: Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=
# Currency Paystack charges in. Prices are set in USD and converted at the live rate.
PAYSTACK_CURRENCY=GHS
# Fallback USD->GHS rate if the live rate service is unreachable
USD_GHS_CONVERSION_RATE=12.1
# Optional: split payments to a subaccount
PAYSTACK_SUBACCOUNT_CODE=

# Comma-separated sites allowed to call the API. Add your live domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Khaya AI (GhanaNLP): local-language transcripts + translation.
# Get a key by subscribing at https://translation.ghananlp.org
KHAYA_API_KEY=

# Public URL of this API (used in podcast feed links), e.g. https://sonicpure-api.onrender.com
PUBLIC_API_URL=
# Public URL of the website (shown as the podcast's website link)
PUBLIC_SITE_URL=

# Anthropic (Claude): writes meeting minutes. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
